# Copy to .env (git-ignored) and set real values. Never commit .env.
POSTGRES_DB=weighingms
POSTGRES_USER=weighingms
POSTGRES_PASSWORD=change-me
# Host port for the dev database (5433 avoids a native Postgres on 5432)
POSTGRES_PORT=5433
# Simulators container environment (Development enables /_sim/* control endpoints)
SIMULATORS_ENVIRONMENT=Development
