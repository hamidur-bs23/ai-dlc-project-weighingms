# Copy to production.env (chmod 600) and fill in. Never commit the filled-in file.
WMS_VERSION=1.0.0

# Database (Postgres 17 on the Compose network; no host port)
POSTGRES_DB=weighingms
POSTGRES_USER=weighingms
POSTGRES_PASSWORD=            # required: e.g. `openssl rand -hex 24`

# The Api listens on 127.0.0.1:${API_PORT}; the TLS reverse proxy forwards to it
API_PORT=5080

# Station identity and plant time (PD-06). Unconfirmed defaults:
STATION_ID=STATION 01
STATION_TIME_ZONE=Asia/Dhaka
