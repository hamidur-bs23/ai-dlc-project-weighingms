{
  "ConnectionStrings": {
    "Db": ""
  },
  "Station": {
    "StationId": "STATION 01",
    "TimeZone": "Asia/Dhaka",
    "StepUpGrantLifetime": "00:02:00",
    "MaxFailedPinAttempts": 5,
    "LockoutDuration": "00:05:00",
    "StepUpActions": [
      "override"
    ]
  },
  "RateLimits": {
    "AuthPermitLimitPerMinute": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Fatal",
        "Microsoft.Extensions.Http.Resilience": "Warning"
      }
    },
    "_note": "Polly's own resilience events are silenced: every failed integration call is already logged once as a Warning by the request log (503), per coding-standards."
  },
  "AllowedHosts": "*",
  "Devices": {
    "ScalePollInterval": "00:00:00.250",
    "ZeroBands": {
      "scale-3kg": 0.5,
      "scale-32kg": 0.002
    }
  },
  "Weighing": {
    "ScaleSelection": {
      "_note": "FR-8: target <= ThresholdKg (inclusive) -> Precision scale, else Heavy-Duty. Applies to sessions started after a change (A1).",
      "ThresholdKg": 3.0,
      "Assignments": {
        "Precision": "scale-3kg",
        "HeavyDuty": "scale-32kg"
      }
    }
  },
  "Integrations": {
    "Simulators": {
      "BaseUrl": "http://localhost:5090",
      "AttemptTimeout": "00:00:01",
      "CircuitBreakerMinimumThroughput": 10,
      "CircuitBreakerBreakDuration": "00:00:05"
    }
  },
  "Tolerances": {
    "Entries": []
  }
}
